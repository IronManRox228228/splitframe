    "talk.mp4": {
      "durationSec": 136.133,
      "kind": "speech",
      "segments": [
        {
          "kind": "speech",
          "text": "Let us start with pricing, because it is the first question everyone asks.",
          "startSec": 0,
          "endSec": 4.413,
          "topic": "pricing"
        },
        {
          "kind": "speech",
          "text": "The starter plan costs nine dollars a month and includes the full editor.",
          "startSec": 4.593,
          "endSec": 8.283,
          "topic": "pricing"
        },
        {
          "kind": "speech",
          "text": "The team plan is nineteen dollars per seat and adds shared libraries.",
          "startSec": 8.463,
          "endSec": 12.264,
          "topic": "pricing"
        },
        {
          "kind": "speech",
          "text": "We do not charge extra for exports, so you can render as many videos as you like.",
          "startSec": 12.444,
          "endSec": 17.411,
          "topic": "pricing"
        },
        {
          "kind": "speech",
          "text": "Annual billing saves you twenty percent compared to paying monthly.",
          "startSec": 17.591,
          "endSec": 20.986,
          "topic": "pricing"
        },
        {
          "kind": "speech",
          "text": "Students and teachers get half off the starter plan with a school email.",
          "startSec": 21.166,
          "endSec": 24.839,
          "topic": "pricing"
        },
        {
          "kind": "speech",
          "text": "If you outgrow a plan, you can upgrade at any time and only pay the difference.",
          "startSec": 25.019,
          "endSec": 29.636,
          "topic": "pricing"
        },
        {
          "kind": "speech",
          "text": "There are no hidden fees, no watermarks, and no surprise price increases.",
          "startSec": 29.816,
          "endSec": 34.918,
          "topic": "pricing"
        },
        {
          "kind": "pause",
          "startSec": 34.918,
          "endSec": 35.918,
          "boundary": true
        },
        {
          "kind": "speech",
          "text": "Now I want to tell you about Maria, who runs a small bakery in Lisbon.",
          "startSec": 35.918,
          "endSec": 40.127,
          "topic": "customer"
        },
        {
          "kind": "speech",
          "text": "Maria had never edited a video before she found our app last spring.",
          "startSec": 40.307,
          "endSec": 43.949,
          "topic": "customer"
        },
        {
          "kind": "speech",
          "text": "She filmed her sourdough process on her phone and dropped the clips into the timeline.",
          "startSec": 44.129,
          "endSec": 48.397,
          "topic": "customer"
        },
        {
          "kind": "speech",
          "text": "In one afternoon she cut a two minute story about her family recipe.",
          "startSec": 48.577,
          "endSec": 52.286,
          "topic": "customer"
        },
        {
          "kind": "speech",
          "text": "Her video was shared by thousands of food lovers and her bakery sold out in three days.",
          "startSec": 52.466,
          "endSec": 57.164,
          "topic": "customer"
        },
        {
          "kind": "speech",
          "text": "Maria told us she now posts a new video every single week.",
          "startSec": 57.344,
          "endSec": 60.591,
          "topic": "customer"
        },
        {
          "kind": "speech",
          "text": "She says the captions feature helped her reach customers who watch with the sound off.",
          "startSec": 60.771,
          "endSec": 64.929,
          "topic": "customer"
        },
        {
          "kind": "speech",
          "text": "Today her bakery has doubled in size and she hired two apprentices.",
          "startSec": 65.109,
          "endSec": 68.747,
          "topic": "customer"
        },
        {
          "kind": "pause",
          "startSec": 68.747,
          "endSec": 69.747,
          "boundary": true
        },
        {
          "kind": "speech",
          "text": "Next, let me walk you through the product itself.",
          "startSec": 69.747,
          "endSec": 72.721,
          "topic": "demo"
        },
        {
          "kind": "speech",
          "text": "You begin by importing your footage, and the app analyzes every clip automatically.",
          "startSec": 72.901,
          "endSec": 77.573,
          "topic": "demo"
        },
        {
          "kind": "speech",
          "text": "The timeline shows your video tracks on top and your audio tracks underneath.",
          "startSec": 77.753,
          "endSec": 81.701,
          "topic": "demo"
        },
        {
          "kind": "speech",
          "text": "To trim a clip, you simply drag its edge to the moment you want.",
          "startSec": 81.881,
          "endSec": 85.517,
          "topic": "demo"
        },
        {
          "kind": "speech",
          "text": "You can split a clip at the playhead and delete the parts you do not need.",
          "startSec": 85.697,
          "endSec": 89.134,
          "topic": "demo"
        },
        {
          "kind": "speech",
          "text": "The inspector lets you adjust scale, position, opacity, and volume.",
          "startSec": 89.314,
          "endSec": 93.573,
          "topic": "demo"
        },
        {
          "kind": "speech",
          "text": "When you are happy with the edit, the export button renders the final movie.",
          "startSec": 93.753,
          "endSec": 97.805,
          "topic": "demo"
        },
        {
          "kind": "speech",
          "text": "The whole workflow runs locally on your computer, so your footage never leaves your machine.",
          "startSec": 97.985,
          "endSec": 102.95,
          "topic": "demo"
        },
        {
          "kind": "pause",
          "startSec": 102.95,
          "endSec": 103.95,
          "boundary": true
        },
        {
          "kind": "speech",
          "text": "Finally, a quick word about hiring, because we are growing fast.",
          "startSec": 103.95,
          "endSec": 108.096,
          "topic": "hiring"
        },
        {
          "kind": "speech",
          "text": "We are looking for two senior engineers who love graphics programming.",
          "startSec": 108.276,
          "endSec": 111.861,
          "topic": "hiring"
        },
        {
          "kind": "speech",
          "text": "We also need a product designer to shape the look of the editor.",
          "startSec": 112.041,
          "endSec": 115.132,
          "topic": "hiring"
        },
        {
          "kind": "speech",
          "text": "Our team works remotely across five time zones and meets once a quarter.",
          "startSec": 115.312,
          "endSec": 119.195,
          "topic": "hiring"
        },
        {
          "kind": "speech",
          "text": "Every employee receives equity, a learning budget, and flexible working hours.",
          "startSec": 119.375,
          "endSec": 124.457,
          "topic": "hiring"
        },
        {
          "kind": "speech",
          "text": "If you are interested, send us a short note and a link to something you built.",
          "startSec": 124.637,
          "endSec": 128.786,
          "topic": "hiring"
        },
        {
          "kind": "speech",
          "text": "We read every application personally and reply within a week.",
          "startSec": 128.966,
          "endSec": 132.224,
          "topic": "hiring"
        },
        {
          "kind": "speech",
          "text": "Thank you so much for your time, and have a wonderful rest of your day.",
          "startSec": 132.404,
          "endSec": 136.115,
          "topic": "hiring"
        }
