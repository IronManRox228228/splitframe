{
  "name": "opencardboard",
  "version": "0.1.0",
  "private": true,
  "description": "Cutboard — local-first desktop AI video editor (open-source chat-to-edit). Repo: openCardboard.",
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@cutboard/desktop",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "turbo run lint",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild",
      "sqlite-vec",
      "electron-winstaller",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.5.0",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "eslint": "^9.35.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  }
}
