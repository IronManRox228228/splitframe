          "style": {"fontSize": 0.11, "fontWeight": 900, "color": "#38BDF8", "align": "center"},
          "transform": {"x": 0.50, "y": 0.44},
          "keyframes": {
            "scale": [[0.0, 0.5, "easeOutCubic"], [0.4, 1.0, "linear"], [3.6, 1.0, "easeInCubic"], [4.0, 0.8, "linear"]],
            "opacity": [[0.0, 0.0, "linear"], [0.3, 1.0, "linear"], [3.6, 1.0, "linear"], [4.0, 0.0, "linear"]]
          }
        },
        {
          "kind": "text",
          "id": "lbl",
