          "style": {"fontSize": 0.028, "fontWeight": 400, "color": "#9CA3AF", "align": "center"},
          "transform": {"x": 0.50, "y": 0.56},
          "keyframes": {
            "opacity": [[0.5, 0.0, "linear"], [1.0, 1.0, "linear"], [4.2, 1.0, "linear"], [4.7, 0.0, "linear"]]
          }
        }
      ]
