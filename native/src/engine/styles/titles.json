          "style": {"fontSize": 0.045, "fontWeight": 600, "color": "#FFFFFF", "align": "center"},
          "transform": {"x": 0.50, "y": 0.46},
          "keyframes": {
            "opacity": [[0.3, 0.0, "linear"], [0.8, 1.0, "linear"], [4.3, 1.0, "linear"], [4.8, 0.0, "linear"]]
