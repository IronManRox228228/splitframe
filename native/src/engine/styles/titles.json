    {
      "name": "headline-kinetic",
      "description": "Dynamic headline where words punch in sequentially 0.15s apart.",
      "whenToUse": ["hook", "headline", "dynamic", "intro", "short"],
      "avoidWhen": ["calm", "formal"],
      "aspect": "any",
      "fields": {
        "words": {"default": "MAKE IT POP", "maxChars": 36}
      },
      "durationSec": 3.5,
      "layers": [
        {
          "kind": "text",
          "id": "word_{i}",
          "repeat": "words",
          "repeatMin": 1,
          "repeatMax": 3,
          "text": "{word}",
          "stepSec": 0.15,
          "ySpacing": 0.09,
          "shiftRule": "cascade",
          "style": {"fontSize": 0.07, "fontWeight": 800, "color": "#FFFFFF", "align": "center"},
          "transform": {"x": 0.50, "y": 0.50},
          "keyframes": {
            "scale": [[0.0, 0.0, "easeOutCubic"], [0.25, 1.0, "linear"], [3.2, 1.0, "easeInCubic"], [3.5, 0.0, "linear"]]
          }
        }
      ]
    },
    {
      "name": "big-number",
      "description": "Stat counter style with large focal number and descriptive label.",
      "whenToUse": ["stats", "data", "metric", "business", "explainer"],
      "avoidWhen": ["cinematic", "music-video"],
      "aspect": "any",
      "fields": {
        "number": {"default": "98%", "maxChars": 12},
        "label": {"default": "Customer Satisfaction", "maxChars": 36}
      },
      "durationSec": 4.0,
      "layers": [
        {
          "kind": "text",
          "id": "num",
