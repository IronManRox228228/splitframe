{
  "version": 1,
  "kind": "title",
  "items": [
    {
      "name": "lower-third-clean",
      "description": "Name + role bar, slides in from the left, holds, slides out.",
      "whenToUse": ["interview", "documentary", "speaker", "corporate"],
      "avoidWhen": ["music-video"],
      "aspect": "landscape",
      "fields": {
        "title": {"default": "Jane Doe", "maxChars": 32},
        "subtitle": {"default": "Director", "maxChars": 40}
      },
      "durationSec": 4.0,
      "layers": [
        {
          "kind": "shape",
          "id": "bar",
          "shape": {"shape": "rect", "fill": "#111111", "width": 0.34, "height": 0.09, "radius": 0.004},
          "transform": {"x": 0.07, "y": 0.80, "anchor": "left"},
          "keyframes": {
            "positionX": [[0.0, -0.4, "easeOutCubic"], [0.45, 0.07, "linear"], [3.55, 0.07, "easeInCubic"], [4.0, -0.4, "linear"]]
          }
        },
        {
          "kind": "text",
          "id": "t1",
          "text": "{title}",
          "style": {"fontSize": 0.042, "fontWeight": 700, "color": "#FFFFFF", "align": "left"},
          "transform": {"x": 0.085, "y": 0.79},
          "keyframes": {
            "opacity": [[0.2, 0.0, "linear"], [0.55, 1.0, "linear"], [3.5, 1.0, "linear"], [3.8, 0.0, "linear"]]
          }
        },
        {
          "kind": "text",
          "id": "t2",
          "text": "{subtitle}",
          "style": {"fontSize": 0.026, "fontWeight": 500, "color": "#BBBBBB", "align": "left"},
          "transform": {"x": 0.085, "y": 0.835},
          "keyframes": {
            "opacity": [[0.3, 0.0, "linear"], [0.65, 1.0, "linear"], [3.5, 1.0, "linear"], [3.8, 0.0, "linear"]]
          }
        }
      ],
      "effects": [{"layer": "t1", "effectId": "glow", "params": {"intensity": 0.2}}]
    },
