            "opacity": [[0.2, 0.0, "linear"], [0.6, 1.0, "linear"], [3.5, 1.0, "linear"], [3.9, 0.0, "linear"]]
          }
        }
      ]
    },
    {
      "name": "quote-card",
      "description": "Editorial quote card on a dim full-frame backdrop with speaker attribution.",
      "whenToUse": ["quote", "interview", "testimonial", "documentary"],
      "avoidWhen": ["action", "trailer"],
      "aspect": "any",
