{
  "version": 1,
  "kind": "recipe",
  "items": [
    {
      "name": "punchy-promo",
      "description": "High-energy commercial cut: punchy teal-orange colour, quick dynamic transitions, social loudness target and subtle film grain texture.",
      "whenToUse": ["promo", "product", "high-energy", "trailer", "commercial"],
      "avoidWhen": ["interview", "documentary", "slow"],
      "steps": [
        {"command": "look.apply", "args": {"look": "teal-orange", "intensity": 0.8, "itemIds": "$videoItems", "apply": true, "force": true}},
        {"command": "transition.add", "args": {"trackId": "$mainVideoTrack", "effectId": "gl_crosswarp", "duration": 8}},
        {"command": "mix.applyProfile", "args": {"profile": "social", "apply": true}},
        {"command": "effect.add", "args": {"itemId": "$eachVideoItem", "effectId": "film_grain", "params": {"amount": 0.15}}}
      ],
      "verify": [
        {"command": "pacing.check", "args": {"profile": "trailer"}},
        {"command": "audio.check", "args": {}}
      ]
    },
    {
      "name": "calm-documentary",
      "description": "Gentle observational style: warm documentary grade, soft crossfades, natural podcast dialogue levels.",
      "whenToUse": ["documentary", "calm", "observational", "nature", "story", "human"],
      "avoidWhen": ["music-video", "promo", "action", "high-energy"],
      "steps": [
        {"command": "look.apply", "args": {"look": "warm-documentary", "intensity": 0.7, "itemIds": "$videoItems", "apply": true, "force": true}},
        {"command": "transition.add", "args": {"trackId": "$mainVideoTrack", "effectId": "crossfade", "duration": 12}},
        {"command": "mix.applyProfile", "args": {"profile": "podcast", "apply": true}}
      ],
      "verify": [
        {"command": "pacing.check", "args": {"profile": "documentary"}},
        {"command": "audio.check", "args": {}}
      ]
    },
    {
