        {"command": "mix.applyProfile", "args": {"profile": "cinematic", "apply": true}},
        {"command": "effect.add", "args": {"itemId": "$eachVideoItem", "effectId": "vignette", "params": {"amount": 0.5}}}
      ],
      "verify": [
        {"command": "pacing.check", "args": {"profile": "trailer"}},
        {"command": "audio.check", "args": {}}
      ]
