    {
      "name": "retro-vhs",
      "description": "Nostalgic analogue aesthetic: pastel colour grade, soft directional wipes, tracking distortion and subtle chromatic fringing.",
      "whenToUse": ["retro", "vhs", "nostalgic", "glitch", "stylised", "vintage", "analog"],
      "avoidWhen": ["corporate", "clean", "interview"],
      "steps": [
        {"command": "look.apply", "args": {"look": "pastel", "intensity": 0.75, "itemIds": "$videoItems", "apply": true, "force": true}},
        {"command": "transition.add", "args": {"trackId": "$mainVideoTrack", "effectId": "wipe", "duration": 10}},
        {"command": "mix.applyProfile", "args": {"profile": "streaming", "apply": true}},
        {"command": "effect.add", "args": {"itemId": "$eachVideoItem", "effectId": "vhs", "params": {"amount": 0.35}}},
        {"command": "effect.add", "args": {"itemId": "$eachVideoItem", "effectId": "chromatic_aberration", "params": {"amount": 0.005}}}
      ],
      "verify": [
        {"command": "pacing.check", "args": {"profile": "social-short"}},
        {"command": "audio.check", "args": {}}
      ]
    }
  ]
