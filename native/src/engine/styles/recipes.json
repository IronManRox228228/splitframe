        {"command": "transition.add", "args": {"trackId": "$mainVideoTrack", "effectId": "crossfade", "duration": 6}},
        {"command": "mix.applyProfile", "args": {"profile": "streaming", "apply": true}},
        {"command": "effect.add", "args": {"itemId": "$eachVideoItem", "effectId": "sharpen", "params": {"amount": 0.2}}}
      ],
      "verify": [
        {"command": "pacing.check", "args": {"profile": "interview"}},
        {"command": "audio.check", "args": {}}
