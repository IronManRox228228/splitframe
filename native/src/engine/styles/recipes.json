        {"command": "transition.add", "args": {"trackId": "$mainVideoTrack", "effectId": "gl_simple_zoom", "duration": 6}},
        {"command": "mix.applyProfile", "args": {"profile": "streaming", "apply": true}},
        {"command": "effect.add", "args": {"itemId": "$eachVideoItem", "effectId": "vignette", "params": {"amount": 0.4}}}
      ],
      "verify": [
        {"command": "pacing.check", "args": {"profile": "music-video"}},
        {"command": "audio.check", "args": {}}
      ]
    },
    {
      "name": "vlog-clean",
      "description": "Clean modern creator look: honest neutral grade, subtle crossfades, crisp clarity and clear streaming speech mix.",
      "whenToUse": ["vlog", "lifestyle", "clean", "talking-head", "social", "creator"],
      "avoidWhen": ["gritty", "dark", "thriller", "horror"],
      "steps": [
