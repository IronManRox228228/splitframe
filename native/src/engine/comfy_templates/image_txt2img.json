{
  "id": "image_txt2img",
  "name": "Text to image (1280x720)",
  "kind": "image",
  "description": "Generate a 1280x720 still image from a text prompt with a checkpoint model. Class types are confirmed against the built-in sd15_txt2img workflow; the model file is a placeholder the user must provide.",
  "whenToUse": [
    "still",
    "background",
    "1280x720"
  ],
  "outputKind": "image",
  "graph": {
    "3": {
      "class_type": "KSampler",
      "inputs": {
        "cfg": 8,
        "denoise": 1,
        "latent_image": [
          "5",
          0
        ],
        "model": [
          "4",
          0
        ],
        "negative": [
          "7",
          0
        ],
        "positive": [
          "6",
          0
        ],
        "sampler_name": "euler",
        "scheduler": "normal",
        "seed": 0,
        "steps": 20
      },
      "_meta": {
        "title": "KSampler"
      }
    },
    "4": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {
        "ckpt_name": "sd15.safetensors"
      },
      "_meta": {
        "title": "Load Checkpoint"
      }
    },
    "5": {
      "class_type": "EmptyLatentImage",
      "inputs": {
        "batch_size": 1,
        "height": 720,
        "width": 1280
      },
      "_meta": {
        "title": "Empty Latent Image"
      }
    },
    "6": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": [
          "4",
          1
        ],
        "text": "masterpiece, best quality"
      },
      "_meta": {
        "title": "CLIP Text Encode (Prompt)"
      }
    },
    "7": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": [
          "4",
          1
        ],
        "text": "bad quality, blurry"
      },
      "_meta": {
        "title": "CLIP Text Encode (Prompt)"
      }
    },
    "8": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "3",
          0
        ],
        "vae": [
          "4",
          2
        ]
      },
      "_meta": {
        "title": "VAE Decode"
      }
    },
    "9": {
      "class_type": "SaveImage",
      "inputs": {
        "filename_prefix": "ComfyUI",
        "images": [
          "8",
          0
        ]
      },
      "_meta": {
        "title": "Save Image"
      }
    }
  },
  "outputNode": "9",
  "bindings": {
    "prompt": {
      "node": "6",
      "input": "text"
    },
    "negative": {
      "node": "7",
      "input": "text"
    },
    "seed": {
      "node": "3",
      "input": "seed"
    },
    "width": {
      "node": "5",
      "input": "width"
    },
    "height": {
      "node": "5",
      "input": "height"
    },
    "steps": {
      "node": "3",
      "input": "steps"
    }
  },
  "requires": {
    "nodes": [
      "KSampler",
      "CheckpointLoaderSimple",
      "EmptyLatentImage",
      "CLIPTextEncode",
      "VAEDecode",
      "SaveImage"
    ],
    "models": [
      {
        "folder": "checkpoints",
        "file": "sd15.safetensors"
      }
    ]
  },
  "needsUserModel": true
}
