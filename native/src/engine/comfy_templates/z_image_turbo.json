{
  "id": "z_image_turbo",
  "name": "Z-Image Turbo",
  "kind": "image",
  "outputKind": "image",
  "description": "Fast photorealistic text-to-image generation using Z-Image Turbo (Q8 GGUF) and Qwen 3.4B in 16 steps.",
  "whenToUse": [
    "still",
    "photo",
    "cinematic",
    "concept",
    "character",
    "background"
  ],
  "graph": {
    "1": {
      "class_type": "UnetLoaderGGUF",
      "inputs": {
        "unet_name": "z-image-turbo-Q8_0.gguf"
      }
    },
    "2": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "qwen_3_4b_fp8_mixed.safetensors",
        "type": "lumina2",
        "device": "default"
      }
    },
    "3": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "ae.safetensors"
      }
    },
    "4": {
      "class_type": "ModelSamplingAuraFlow",
      "inputs": {
        "model": [
          "1",
          0
        ],
        "shift": 3.0
      }
    },
    "5": {
      "class_type": "EmptySD3LatentImage",
      "inputs": {
        "batch_size": 1,
        "height": 1024,
        "width": 1024
      }
    },
    "6": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": [
          "2",
          0
        ],
        "text": "cinematic photo, detailed, natural lighting, high quality"
      }
    },
    "7": {
      "class_type": "ConditioningZeroOut",
      "inputs": {
        "conditioning": [
          "6",
          0
        ]
      }
    },
    "8": {
      "class_type": "KSampler",
      "inputs": {
        "cfg": 1,
        "denoise": 1,
        "latent_image": [
          "5",
          0
        ],
        "model": [
          "4",
          0
        ],
        "negative": [
          "7",
          0
        ],
        "positive": [
          "6",
          0
        ],
        "sampler_name": "res_multistep",
        "scheduler": "simple",
        "seed": 0,
        "steps": 16
      }
    },
    "9": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "8",
          0
        ],
        "vae": [
          "3",
          0
        ]
      }
    },
    "10": {
      "class_type": "SaveImage",
      "inputs": {
        "filename_prefix": "splitframe/z_image_turbo",
        "images": [
          "9",
          0
        ]
      }
    }
  },
  "outputNode": "10",
  "bindings": {
    "prompt": {
      "node": "6",
      "input": "text"
    },
    "seed": {
      "node": "8",
      "input": "seed"
    },
    "steps": {
      "node": "8",
      "input": "steps"
    },
    "width": {
      "node": "5",
      "input": "width"
    },
    "height": {
      "node": "5",
      "input": "height"
    }
  },
  "requires": {
    "nodes": [
      "UnetLoaderGGUF",
      "CLIPLoader",
      "VAELoader",
      "ModelSamplingAuraFlow",
      "EmptySD3LatentImage",
      "CLIPTextEncode",
      "ConditioningZeroOut",
      "KSampler",
      "VAEDecode",
      "SaveImage"
    ],
    "models": [
      {
        "folder": "diffusion_models",
        "file": "z-image-turbo-Q8_0.gguf"
      },
      {
        "folder": "text_encoders",
        "file": "qwen_3_4b_fp8_mixed.safetensors"
      },
      {
        "folder": "vae",
        "file": "ae.safetensors"
      }
    ]
  },
  "needsUserModel": false
}
