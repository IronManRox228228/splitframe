{
  "id": "ace_step_music",
  "name": "ACE-Step 1.5 Turbo",
  "kind": "music",
  "outputKind": "audio",
  "description": "Generate music tracks and background audio from style prompts and tempo using ACE-Step 1.5 Turbo in 32 steps.",
  "whenToUse": [
    "music",
    "soundtrack",
    "background music",
    "score",
    "ambient",
    "beat",
    "instrumental"
  ],
  "graph": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "acestep_v1.5_turbo.safetensors",
        "weight_dtype": "default"
      }
    },
    "2": {
      "class_type": "DualCLIPLoader",
      "inputs": {
        "clip_name1": "qwen_0.6b_ace15.safetensors",
        "clip_name2": "qwen_1.7b_ace15.safetensors",
        "device": "default",
        "type": "ace"
      }
    },
    "3": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "ace_1.5_vae.safetensors"
      }
    },
    "4": {
      "class_type": "ModelSamplingAuraFlow",
      "inputs": {
        "model": [
          "1",
          0
        ],
        "shift": 3.0
      }
    },
    "5": {
      "class_type": "EmptyAceStep1.5LatentAudio",
      "inputs": {
        "batch_size": 1,
        "seconds": 30.0
      }
    },
    "6": {
      "class_type": "TextEncodeAceStepAudio1.5",
