  "requires": {
    "nodes": [
      "UNETLoader",
      "DualCLIPLoader",
      "VAELoader",
      "ModelSamplingAuraFlow",
      "EmptyAceStep1.5LatentAudio",
      "TextEncodeAceStepAudio1.5",
