        "bpm": 120,
        "clip": [
          "2",
          0
        ],
        "duration": 30.0,
        "keyscale": "C major",
        "language": "en",
        "lyrics": "",
        "seed": 0,
        "tags": "cinematic soundtrack, atmospheric, emotional, instrumental",
        "timesignature": "4",
        "generate_audio_codes": true,
        "cfg_scale": 2.0,
        "temperature": 0.85,
        "top_p": 0.9,
        "top_k": 0,
        "min_p": 0.0
      }
    },
    "7": {
      "class_type": "ConditioningZeroOut",
      "inputs": {
        "conditioning": [
          "6",
          0
        ]
      }
    },
    "8": {
      "class_type": "KSampler",
      "inputs": {
        "cfg": 1,
        "denoise": 1,
        "latent_image": [
          "5",
          0
        ],
        "model": [
          "4",
          0
        ],
        "negative": [
          "7",
          0
        ],
        "positive": [
          "6",
          0
        ],
        "sampler_name": "euler",
        "scheduler": "simple",
        "seed": 0,
        "steps": 32
      }
    },
    "9": {
      "class_type": "VAEDecodeAudio",
      "inputs": {
        "samples": [
          "8",
          0
        ],
        "vae": [
          "3",
          0
        ]
      }
    },
    "10": {
      "class_type": "SaveAudioMP3",
      "inputs": {
        "audio": [
          "9",
          0
        ],
        "filename_prefix": "splitframe/ace_step_music",
        "quality": "V0"
      }
    }
  },
  "outputNode": "10",
  "bindings": {
    "prompt": {
      "node": "6",
      "input": "tags"
    },
    "tags": {
      "node": "6",
      "input": "tags"
    },
    "lyrics": {
      "node": "6",
      "input": "lyrics"
    },
    "bpm": {
      "node": "6",
      "input": "bpm"
    },
