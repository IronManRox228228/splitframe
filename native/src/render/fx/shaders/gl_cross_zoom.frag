// @range(0, 1) Blur strength

const float PI = 3.141592653589793;

float Linear_ease(in float begin, in float change, in float duration, in float time_) {
    return change * time_ / duration + begin;
}

float Exponential_easeInOut(in float begin, in float change, in float duration, in float time_) {
    if (time_ == 0.0)
        return begin;
    else if (time_ == duration)
        return begin + change;
    time_ = time_ / (duration / 2.0);
    if (time_ < 1.0)
        return change / 2.0 * pow(2.0, 10.0 * (time_ - 1.0)) + begin;
    return change / 2.0 * (-pow(2.0, -10.0 * (time_ - 1.0)) + 2.0) + begin;
}

float Sinusoidal_easeInOut(in float begin, in float change, in float duration, in float time_) {
    return -change / 2.0 * (cos(PI * time_ / duration) - 1.0) + begin;
}

float rand (vec2 co) {
